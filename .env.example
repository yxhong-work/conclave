# Conclave environment variables — copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# LLM (required) — the consensus / stance / question-gen / P_X / planner model
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-api-key
LLM_MODEL=gpt-5.6-luna
# LLM_MAX_TOKENS=8192
# LLM_TEMPERATURE=1
# LLM_TIMEOUT=60.0

# ---------------------------------------------------------------------------
# MCP research stage (SPEC docs/MCP_SPEC.md §6)
# ---------------------------------------------------------------------------
# Set MCP_ENABLED=true to run external research during analysis (A1 draft →
# research → A3 final). When false, the mcp package isn't even imported.
MCP_ENABLED=false
# csv subset of: maps, apify_threads_post, realping (session-backed providers
# routed through research_phase). web_search is OpenAI-native — it uses
# OPENAI_API_KEY via openaiTools, NOT this list.
MCP_PROVIDERS=
# A tool-calling-capable model for the planner LLM call (required when enabled).
MCP_RESEARCH_MODEL=
# MCP_REQUIRED=false  # if true, research degrade sets group status=error
# MCP_MAX_TOOL_CALLS=3
# MCP_RESULT_CHARS=3000
# MCP_TOTAL_RESULT_CHARS=12000
# MCP_TOOL_TIMEOUT_S=30
# MCP_CONNECT_TIMEOUT_S=10
# MCP_RUN_TIMEOUT_S=180
# MCP_RESEARCH_MAX_TOKENS=1024
# MCP_ALLOW_OPINION_CONTEXT=false
# MCP_LOG_VERBOSE=false

# ---------------------------------------------------------------------------
# Adaptive per-member questioning (SPEC docs/ADAPTIVE_SPEC.md §12)
# ---------------------------------------------------------------------------
# Global kill-switch: false → P stage skipped, /my-question 404, /state
# reports adaptive_questions=false. Per-group flag is set at group creation.
ADAPTIVE_QUESTIONS_ENABLED=true
# ADAPTIVE_P_MAX_MEMBERS=20  # P stage skips groups with more submitted members

# ---------------------------------------------------------------------------
# MCP provider credentials — only set the keys for providers you enabled.
# Names match the api_key_env / base_url_env fields in mcp_config.yaml.
# ---------------------------------------------------------------------------

# maps (Google Maps) — used when MCP_PROVIDERS includes "maps"
GOOGLE_MAPS_API_KEY=

# apify_threads_post (Threads search) — used when MCP_PROVIDERS includes "apify_threads_post"
APIFY_TOKEN=

# realping (Taiwan real-estate) — used when MCP_PROVIDERS includes "realping"
REALPING_API_KEY=

# web_search (OpenAI-native, via openaiTools / test_mcp.py, NOT research_phase)
# Distinct from LLM_API_KEY — set this to use the web_search tool.
OPENAI_API_KEY=

# Local OpenAI-compatible model for openaiTools' local-first path
# (mcp_config.yaml models.local.base_url_env). Leave empty to use OpenAI instead.
LOCAL_OPENAI_BASE_URL=
LOCAL_API_KEY=local

# ---------------------------------------------------------------------------
# ReasoningBank-Lite memory sidecar
# ---------------------------------------------------------------------------
# Enable the memory hooks in the backend (before_task / after_task).
# Fail-open: if the sidecar is down, the backend degrades to empty context /
# no memory storage without breaking the deliberation flow.
RBANK_ENABLED=true
RBANK_BASE_URL=http://reasoningbank:8000
# Embedding model for memory retrieval (OpenAI-compatible, shares LLM_API_KEY).
RB_EMBEDDING_MODEL=text-embedding-3-large
# Thresholds calibrated for text-embedding-3-large — recalibrate if you
# switch embedding models (see reasoningbank_lite_development_spec.md §10.3).
RB_RETRIEVAL_TOP_K=3
RB_SIMILARITY_THRESHOLD=0.30
RB_DEDUP_THRESHOLD=0.85
# RB_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database / server (compose.yml usually sets these; here for local non-Docker dev)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://conclave:conclave@localhost:5432/conclave
# SSE_KEEPALIVE_S=15
# DEADLINE_SCAN_S=5
